<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Fable.Temporal</PackageId>
    <ChangelogFile>$(MSBuildThisFileDirectory)../../CHANGELOG.md</ChangelogFile>
    <Description>Strongly typed Fable bindings for JavaScript Temporal, independent of compiler DateTime mappings.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Oliver Coad</Authors>
    <PackageProjectUrl>https://github.com/olivercoad/Fable.Temporal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/olivercoad/Fable.Temporal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fable-javascript;temporal;date;time</PackageTags>
    <FablePackageType>library</FablePackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Temporal.fs" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" />
    <PackageReference Include="Fable.Package.SDK" Version="1.4.1" PrivateAssets="all" />
    <PackageReference Include="Fable.Core" Version="4.5.0" />
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" Version="0.4.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
